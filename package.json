{
  "name": "pvara-compliance-kit",
  "version": "0.2.0",
  "description": "Structuring toolkit for Pakistan VASP compliance under the Virtual Assets Act, 2026 — not legal advice.",
  "license": "MIT",
  "author": "pvara-compliance-kit contributors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "DISCLAIMER.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pvara",
    "pakistan",
    "vasp",
    "compliance",
    "aml",
    "travel-rule",
    "virtual-assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nad33mahm3d/pvara-compliance-kit.git"
  },
  "bugs": {
    "url": "https://github.com/nad33mahm3d/pvara-compliance-kit/issues"
  },
  "homepage": "https://github.com/nad33mahm3d/pvara-compliance-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
